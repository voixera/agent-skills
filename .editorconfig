root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.ps1]
indent_size = 4

[*.psm1]
indent_size = 4

[*.cmd]
indent_style = tab
end_of_line = crlf

[*.bat]
indent_style = tab
end_of_line = crlf

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2
