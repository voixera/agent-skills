{
  "name": "agentskillsmd",
  "version": "2.2.4",
  "description": "Interactive multi-agent skills manager and anti-slop engineering toolkit. Installs modular SKILL.md-based skill packs into supported AI coding agents.",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "codex",
    "claude-code",
    "cursor",
    "copilot",
    "svg",
    "cli",
    "tui",
    "tooling"
  ],
  "license": "MIT",
  "author": "Agent Skills contributors",
  "homepage": "https://github.com/voixera/agent-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voixera/agent-skills.git"
  },
  "bugs": {
    "url": "https://github.com/voixera/agent-skills/issues"
  },
  "type": "commonjs",
  "bin": {
    "agentskillsmd": "bin/agentskillsmd.js"
  },
  "main": "dist/cli/entry.js",
  "files": [
    "bin/",
    "dist/",
    "registry/",
    "skills/",
    "adapters/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node bin/agentskillsmd.js",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 test",
    "validate": "node -e \"require('./dist/core/registry').loadAndValidateRegistry(); console.log('registry valid')\"",
    "sync-version": "node scripts/sync-version.js",
    "bump": "npm version patch && node scripts/sync-version.js",
    "version": "node scripts/sync-version.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
