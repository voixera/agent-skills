{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/agent-skills/schema/agents.schema.json",
  "title": "Agent Skills - Agents Registry",
  "type": "object",
  "required": ["version", "agents"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "adapter", "supportLevel", "evidence", "scopes", "features", "paths", "format"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 2 },
          "adapter": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "supportLevel": { "type": "string", "enum": ["native", "rules", "instructions"] },
          "evidence": { "type": "string", "enum": ["verified", "documented"] },
          "scopes": {
            "type": "array",
            "items": { "type": "string", "enum": ["project", "user"] }
          },
          "features": {
            "type": "array",
            "items": { "type": "string", "enum": ["skills", "rules", "instructions"] }
          },
          "paths": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "detect": { "type": "array", "items": { "type": "string" } },
          "format": { "type": "string" },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "docs": { "type": "string" },
          "installUrl": { "type": "string" }
        }
      }
    }
  }
}
