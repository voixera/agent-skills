{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/agent-skills/schema/skills.schema.json",
  "title": "Agent Skills - Skills Registry",
  "type": "object",
  "required": ["version", "skills"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "version", "path", "agents"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 20 },
          "category": {
            "type": "string",
            "enum": ["frontend", "backend", "ui-ux", "svg", "testing", "security", "devops", "anti-slop"]
          },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "path": { "type": "string", "pattern": "\\.md$" },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "depends": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tools": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
