# Agent Skills - ignore rules

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Test / tooling output
tests/.tmp/
*.testresult.xml
TestResults/
coverage/
.pester/

# Local installation artifacts created by the installer inside THIS repo
# (the installer writes per-target manifests; keep them out of source control)
.agent-skills/*
!.agent-skills/.gitkeep

# Node
node_modules/
npm-debug.log*

# TypeScript build output (regenerated by `npm run build` / `prepare`)
dist/

# Secrets - never commit these
.env
.env.*
*.pem
*.key
secrets.json

# PowerShell
*.clixml
